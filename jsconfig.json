{
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@root/*": [
                "./*"
            ],
            "@config/*": [
                "config/*"
            ],
            "@controllers/*": [
                "./controllers/*"
            ],
            "@helpers/*": [
                "./helpers/*"
            ],
            "@middlewares/*": [
                "./middlewares/*"
            ],
            "@models/*": [
                "./models/*"
            ],
            "@routes/*": [
                "./routes/*"
            ],
            "@services/*": [
                "./services/*"
            ],
            "@utils/*": [
                "./utils/*"
            ]
        }
    },
    "exclude": [
        "node_modules",
        "dist"
    ]
}